POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=CloseLinkit

# Port exposed to host for local database access
DB_HOST_PORT=5432

# DB_URL is used by the Go API running inside Docker.
# Note: 'postgres' is the service name from compose.yaml.
DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
DB_TIMEZONE=America/Chihuahua

# DB_URL_GOOSE is used by Goose for migrations running from the host machine.
# Note: 'localhost' is used here to reach the database exposed on DB_HOST_PORT.
DB_URL_GOOSE=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# API server configuration
API_HOST_PORT=8080
BASE_URL=http://localhost:${API_HOST_PORT}
ALLOWED_ORIGINS=http://localhost:5173

# Frontend configuration
VITE_API_BASE_URL=${BASE_URL}
VITE_HOST_PORT=5173
