# Optional: Specific image version to pull (defaults to latest if unset)
# IMAGE_TAG=0.3.1

# DB_URL is used by the Go API running inside Docker.
# Example for AWS RDS PostgreSQL (sslmode=require is recommended on AWS):
DB_URL=postgres://<db_user>:<db_password>@<rds_endpoint>:5432/<db_name>?sslmode=require

# API server configuration
# ALLOWED_ORIGINS must match the frontend public origin exactly (including protocol and port if non-standard).
# Example when testing with EC2 public IP: http://<frontend_ec2_public_ip>
ALLOWED_ORIGINS=http://<frontend_ec2_public_ip>

# BASE_URL is used to generate shortened URLs returned to users (e.g., BASE_URL/abc1234).
# It MUST point to the public frontend URL so that users resolve links through Nginx.
BASE_URL=http://<frontend_ec2_public_ip>

# Authentication configuration
# Generate a secure 32-byte key: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Cookie Secure configuration:
# Set to 'false' when testing directly over plain HTTP on EC2 IP addresses (otherwise modern browsers reject the cookie).
# Set to 'true' in production when serving behind HTTPS (TLS/SSL).
COOKIE_SECURE=false

# Trust Proxy configuration:
# Set to 'true' in production so the API trusts the X-Real-IP header forwarded by the Nginx reverse proxy.
# This ensures rate limiting and request logging use the real client IP instead of Nginx's IP.
TRUST_PROXY=true