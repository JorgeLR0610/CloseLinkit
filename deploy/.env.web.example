# Optional: Specific image version to pull (defaults to latest if unset)
# IMAGE_TAG=0.3.1

# Nginx Upstream target (IP or hostname of API EC2 instance WITH port 8080)
# Since both EC2 instances will reside in the same VPC, using the private IP is recommended for security and lower latency:
API_UPSTREAM=<api_ec2_private_ip>:8080